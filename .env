# URL pública del sitio, sin "/" final (se usa en Open Graph y JSON-LD). Ej.: https://www.ejemplo.com
# Pendiente: el cliente aún no ha confirmado el dominio.
VITE_SITE_URL=

# Medición (respuesta del cliente #33). Dejar vacío para no cargar scripts de terceros.
# Google Analytics 4, formato G-XXXXXXXXXX
VITE_GA_ID=
# Meta Pixel (Facebook / Instagram), solo números
VITE_META_PIXEL_ID=
# Google Ads: ID de la cuenta (AW-XXXXXXXXXX) y etiquetas de las conversiones
VITE_GADS_ID=
VITE_GADS_LEAD_LABEL=
VITE_GADS_CONTACT_LABEL=

# Modo revisión: true muestra los datos pendientes como etiquetas amarillas.
# Vacío o false (lanzamiento): lo pendiente se oculta.
VITE_SHOW_PENDING=
